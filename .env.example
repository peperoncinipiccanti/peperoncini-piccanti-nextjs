# URL del backend WordPress "headless" (solo API, non serve che sia pubblico
# con un tema visibile). Deve includere il protocollo, senza slash finale.
WP_API_URL=https://cms.peperoncinipiccanti.com

# Token segreto condiviso con il plugin WordPress companion (wp-plugin/) per
# autorizzare la chiamata di revalidazione quando pubblichi/aggiorni un articolo.
REVALIDATE_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale

# URL pubblico del sito Next.js (usato per sitemap, robots, Open Graph assoluti).
NEXT_PUBLIC_SITE_URL=https://www.peperoncinipiccanti.com
