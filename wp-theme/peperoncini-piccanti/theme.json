{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Peperoncini Piccanti",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Bianco", "color": "#ffffff" },
				{ "slug": "sfondo-chiaro", "name": "Grigio chiaro", "color": "#f4f3f1" },
				{ "slug": "testo", "name": "Testo", "color": "#242424" },
				{ "slug": "testo-secondario", "name": "Testo secondario", "color": "#5c5c5c" },
				{ "slug": "notte", "name": "Nero peperoncino", "color": "#141414" },
				{ "slug": "teal", "name": "Teal piccante", "color": "#00a498" },
				{ "slug": "corallo", "name": "Corallo", "color": "#c85849" },
				{ "slug": "bordo", "name": "Bordo chiaro", "color": "#e3e1dd" }
			],
			"gradients": [
				{
					"slug": "hero-overlay",
					"name": "Overlay hero",
					"gradient": "linear-gradient(180deg, rgba(20,20,20,0) 0%, rgba(20,20,20,0.85) 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "lato",
					"name": "Lato",
					"fontFamily": "\"Lato\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Piccolo", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medio", "size": "1rem" },
				{ "slug": "large", "name": "Grande", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra grande", "size": "clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem)" },
				{ "slug": "hero", "name": "Titolo hero", "size": "clamp(2rem, 1.5rem + 2.2vw, 3.5rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.75rem" },
				{ "slug": "40", "name": "L", "size": "2.75rem" },
				{ "slug": "50", "name": "XL", "size": "4.5rem" },
				{ "slug": "60", "name": "XXL", "size": "7rem" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--testo-secondario)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--lato)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--teal)" },
				":hover": { "color": { "text": "var(--wp--preset--color--corallo)" } }
			},
			"heading": {
				"typography": {
					"fontWeight": "900",
					"textTransform": "uppercase",
					"letterSpacing": "0.01em",
					"lineHeight": "1.15"
				},
				"color": { "text": "var(--wp--preset--color--testo)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"button": {
				"typography": {
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"radius": "0px",
					"width": "2px",
					"color": "currentColor",
					"style": "solid"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--notte)"
				},
				"spacing": {
					"padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.6em", "right": "1.6em" }
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--teal)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontWeight": "700", "textTransform": "none" }
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.04em",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "footer", "area": "footer", "title": "Footer" }
	],
	"customTemplates": []
}
